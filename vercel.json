{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/verify", "destination": "/api/verify" },
    { "source": "/api/submit", "destination": "/api/submit" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
